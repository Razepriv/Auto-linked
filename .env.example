# =========================================================================
# Auto-Linked Environment Variables
# Copy to .env and fill in values
# =========================================================================

# --- Database ---
DATABASE_URL=postgres://autolinked:autolinked_dev@localhost:5432/autolinked

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Self-Hosted Mode ---
# Set to "true" to unlock all features without Stripe/payments
# Stripe and Resend keys become optional in this mode
SELF_HOSTED=true

# --- LinkedIn OAuth ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/callback/linkedin

# --- Encryption ---
# Generate with: openssl rand -hex 32
OAUTH_ENCRYPTION_KEY=

# --- AI (OpenAI-compatible: Groq, OpenRouter, OpenAI, etc.) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Stripe (optional in self-hosted mode) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=

# --- Email (optional in self-hosted mode) ---
RESEND_API_KEY=

# --- NextAuth (web app) ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- Backend URL (used by web app BFF proxy) ---
BACKEND_URL=http://localhost:4000
PROXY_SECRET=change-me-in-production

# --- Sentry (optional) ---
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
